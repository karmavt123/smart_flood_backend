# =====================================================================
# FILE .env CHO MÁY CHỦ (dùng với docker-compose.yml)
# Chép thành ".env" rồi đổi TẤT CẢ mật khẩu bên dưới thành chuỗi ngẫu nhiên dài.
# Tạo nhanh 1 chuỗi ngẫu nhiên:  openssl rand -hex 24
# KHÔNG đưa file .env lên GitHub / Zalo / OneDrive chung.
# =====================================================================

# Mật khẩu cơ sở dữ liệu PostgreSQL
POSTGRES_PASSWORD=doi-mat-khau-nay

# Mật khẩu MQTT: backend dùng tài khoản "smartflood-backend", gateway LoRa dùng tài khoản "smartflood-gateway"
MQTT_BACKEND_PASSWORD=doi-mat-khau-nay-nua
MQTT_GATEWAY_PASSWORD=doi-mat-khau-gateway

# Khóa vào trang /admin (ít nhất 16 ký tự)
ADMIN_API_KEY=doi-khoa-admin-dai-it-nhat-16-ky-tu

# Cổng API mở ra ngoài (mặc định 3000). Nếu đặt sau Caddy/Nginx để có HTTPS thì đặt TRUST_PROXY=true.
API_PORT=3000
TRUST_PROXY=false
CORS_ORIGIN=*
