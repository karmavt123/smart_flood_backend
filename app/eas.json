{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "apk": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://flood.agentwf.xyz",
        "EXPO_PUBLIC_DEMO_MODE": "false"
      }
    },
    "apk-demo": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://flood.agentwf.xyz",
        "EXPO_PUBLIC_DEMO_MODE": "true"
      }
    }
  }
}
