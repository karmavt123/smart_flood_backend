# CÁCH DÙNG: sao chép file này thành ".env.local" (cùng thư mục), sửa giá trị, rồi chạy lại app
# (npm run web / npx expo start). File .env.local KHÔNG được đưa lên Git. Đừng để mật khẩu hay khóa bí mật ở đây:
# mọi biến bắt đầu bằng EXPO_PUBLIC_ đều bị nhúng thẳng vào app, ai cũng đọc được.

# Địa chỉ BACKEND SmartFlood mới (thư mục smartflood-backend), không có dấu / ở cuối. Ví dụ:
#   chạy thử backend trên chính laptop này, mở app bằng trình duyệt:  http://localhost:3000
#   mở app trên ĐIỆN THOẠI, backend chạy trên laptop:                 http://192.168.1.15:3000  (IP của laptop)
#   máy chủ thật anh mentor đã deploy:                                https://<tên miền hoặc IP máy chủ>
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# true = CHẾ ĐỘ DEMO: dùng dữ liệu mẫu trong src/demo, không cần mạng, không cần backend.
# Dùng khi thuyết trình ở nơi mạng yếu. App sẽ hiện dải vàng "CHẾ ĐỘ DEMO".
EXPO_PUBLIC_DEMO_MODE=false
