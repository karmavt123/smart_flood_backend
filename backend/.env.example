# =====================================================================
# CẤU HÌNH BACKEND SMARTFLOOD
# Chép file này thành ".env" rồi sửa. File .env chứa mật khẩu: KHÔNG đưa lên GitHub, KHÔNG gửi qua Zalo.
# Chạy thử trên laptop: để trống DATABASE_URL và MQTT_URL là đủ (backend tự bật DB + MQTT nhúng sẵn).
# =====================================================================

# Cổng của API (app và trang admin gọi vào đây)
PORT=3000

# --- Cơ sở dữ liệu ---
# Để trống  → dùng PostgreSQL nhúng (PGlite), dữ liệu lưu ở thư mục EMBEDDED_DB_DIR. Chỉ dùng khi chạy thử.
# Máy chủ thật → postgres://USER:MẬT_KHẨU@HOST:5432/TÊN_DB (docker-compose.yml đã điền sẵn)
DATABASE_URL=
EMBEDDED_DB_DIR=./data/pglite

# --- MQTT (các trạm ESP32 gửi số đo vào đây qua Wi-Fi; backend gửi hệ số công thức xuống trạm) ---
# Để trống  → backend tự bật một broker MQTT nhúng ở EMBEDDED_MQTT_HOST:EMBEDDED_MQTT_PORT (không mật khẩu, chỉ để chạy thử).
# Máy chủ thật → mqtt://mosquitto:1883 (docker-compose.yml đã điền sẵn)
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=smartflood/nodes/+/data
EMBEDDED_MQTT_HOST=127.0.0.1
EMBEDDED_MQTT_PORT=1883

# --- Trang admin ---
# Khóa để vào trang /admin và gọi API /api/v1/admin/*. Máy chủ thật BẮT BUỘC đặt chuỗi dài ít nhất 16 ký tự.
# Chạy thử trên laptop mà để trống thì backend dùng tạm "dev-admin-key".
ADMIN_API_KEY=

# --- Dịch vụ bản đồ bên ngoài ---
# OSRM: tìm đường cho chức năng kiểm tra tuyến. Overpass: lấy hình dạng các con đường từ OpenStreetMap để tô màu đường ngập.
OSRM_URL=https://router.project-osrm.org
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Khác ---
# Trang web nào được gọi API (CORS). "*" = mọi trang (API công khai chỉ đọc nên chấp nhận được).
CORS_ORIGIN=*
# Đặt true khi backend đứng sau Caddy/Nginx, để giới hạn số lần gọi tính đúng IP người dùng.
TRUST_PROXY=false

# --- Máy chủ học lại công thức dự báo (xem README mục 6) ---
# Tự học lại mỗi ngày (true/false). Tắt thì vẫn bấm "Học lại ngay" trong trang admin được.
MODEL_AUTO_RETRAIN=true
# Giờ tự học mỗi ngày, giờ Việt Nam, dạng HH:MM
MODEL_RETRAIN_TIME=00:30
# Học từ dữ liệu bao nhiêu ngày gần nhất
MODEL_TRAINING_DAYS=30
# Cần ít nhất bao nhiêu cặp mẫu lúc đường ĐANG NGẬP mới học (30 cặp × 5 phút = 2,5 giờ ngập)
MODEL_MIN_SAMPLES=30
# Hệ số cũ nặng bao nhiêu so với dữ liệu mới: 0 = bỏ hẳn hệ số cũ, 1 = ngang toàn bộ dữ liệu mới
MODEL_PRIOR_WEIGHT=0.2
